<%- include('../partials/page-hero', { title: 'Food & Drinks', eyebrow: 'Things To Do', lead: 'Meals, snacks and food experiences woven through your visit.', crumbs: [['Things To Do', '/things-to-do'], ['Food & Drinks']] }) %>
<section class="section"><div class="container">
  <header class="section__head"><p class="eyebrow">Eat well</p><h2>Food experiences you can add to your break</h2></header>
  <div class="grid grid--3"><% food.forEach(function (a) { %><%- include('../partials/activity-card', { a: a }) %><% }) %></div>

  <div class="block two-col">
    <div>
      <p class="eyebrow">Coming soon</p><h2>More to taste</h2>
      <p>We are finalising the rest of our food and drinks offer. Planned additions include:</p>
      <ul class="ticks"><li><%- icon('check') %>Picnic hampers</li><li><%- icon('check') %>Campfire meals</li><li><%- icon('check') %>A bar and drinks menu</li></ul>
      <p class="note"><%- icon('info') %>Menus and prices will be published here once confirmed. Tell us about dietary needs when you book.</p>
    </div>
    <div class="callout callout--stack"><%- icon('utensils') %><h3>Farm-to-Fork Day</h3><p>Harvest, cook and eat together. A signature package built around the farm.</p><a class="btn btn--gold" href="/breaks/farm-to-fork-day">See the package</a></div>
  </div>
</div></section>
